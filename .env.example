# Root environment file for the k8s-game-platform superproject.
# Copy this file to .env and adjust values for your environment.

# AWS SAM / deploy defaults
STACK_NAME=k8s-grader-api-dev
AWS_REGION=us-east-1

# Optional: pass a secret hash override through the root deploy wrapper
# SECRET_HASH_OVERRIDE=replace-with-secret-hash

# Optional: default test user for helper scripts
TEST_EMAIL=integration-test@example.com

# Optional: encrypted API key for integration or manual exercise checks
TEST_API_KEY=your-encrypted-api-key-here
